# ------------------------------------------------------------------
# Dune Explorer environment variables
#
# Copy this file to `.env` for local development and set the same keys
# in the Vercel project settings (Settings > Environment Variables).
# NEVER commit real values — `.env` is gitignored.
#
# `VITE_` prefixed variables are embedded in the client bundle and are
# PUBLIC by design (browser site key only). Everything else stays
# server-side and is read only by api/contact.js.
# ------------------------------------------------------------------

# --- Cloudflare Turnstile (bot protection) ---
# Public site key, safe to ship in the browser.
VITE_TURNSTILE_SITE_KEY=0x0000000000000000000000000000000000000000
# Secret key, server-only. When set, api/contact.js REQUIRES a valid token.
TURNSTILE_SECRET_KEY=

# --- EmailJS ---
# The service/template IDs and public key previously hardcoded in the
# client bundle. Moved server-side. Also enable the EmailJS domain
# allow-list in the EmailJS dashboard to your production domain.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# --- Google Sheets / Apps Script ---
# The /exec URL of the Apps Script. Add an origin/ownership check inside
# the script (e.g. verify a request header against a shared secret).
GAS_SHEETS_URL=
# Shared secret the Apps Script checks on incoming requests (e.g. header
# `x-inquiry-token`). Optional but strongly recommended.
GAS_SHARED_TOKEN=

# --- Allowed browser origins for the contact endpoint (comma-separated) ---
# Requests with an Origin header not on this list are rejected (403).
ALLOWED_ORIGINS=https://dunexplore.com,https://www.dunexplore.com
